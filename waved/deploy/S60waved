#!/bin/sh

WAVED_DIR="${WAVED_DIR:-/data/waved}"
UPDATE_DIR="$WAVED_DIR/update"
# Emptied at every boot (tmpfs): the per-boot bookkeeping lives here.
RUN_DIR="${WAVED_RUN_DIR:-/tmp}"
MAX_TRIAL_BOOTS=2
MAX_TRIAL_STARTS_PER_BOOT=10

# Update fall-back (docs/UPDATES.md, "Install and fall-back"). While
# update/trial exists, the version an update installed has not reported
# healthy yet. Count boots, not starts: one boot can take several (the first
# waved is killed after 5 s below, and the speaker can be busy for the first
# seconds of a boot). Go back at the start of the third boot, or after more
# than MAX_TRIAL_STARTS_PER_BOOT starts in one boot (a crash loop): put each
# "restore" file back from its old copy, delete each "remove" file, and leave
# update/rolled-back for the old waved to report. Without a trial file this
# does nothing.
# The old copy of /dir/name is /dir/.name.prev: rcS runs every
# /etc/init.d/S??* at boot, so a copy must never match that glob.
# The updater installs only if this script has the MAX_TRIAL_BOOTS line
# and the prev="..." line below (crates/waved-update/src/install.rs,
# GUARD_MARKERS): older guards also had update_guard but put back the wrong
# copies or counted starts. Change those lines and GUARD_MARKERS together.
update_guard() {
    [ -f "$UPDATE_DIR/trial" ] || return 0
    mkdir -p "$RUN_DIR"
    if [ ! -f "$RUN_DIR/waved-trial-boot" ]; then
        : > "$RUN_DIR/waved-trial-boot"
        echo boot >> "$UPDATE_DIR/boots"
    fi
    echo start >> "$RUN_DIR/waved-trial-starts"
    boots=$(($(wc -l < "$UPDATE_DIR/boots")))
    starts=$(($(wc -l < "$RUN_DIR/waved-trial-starts")))
    if [ "$boots" -le "$MAX_TRIAL_BOOTS" ] && [ "$starts" -le "$MAX_TRIAL_STARTS_PER_BOOT" ]; then
        return 0
    fi
    echo "update not healthy (boot $boots, start $starts of this boot), going back" >> "$WAVED_DIR/waved.log"
    while read -r action path; do
        prev="${path%/*}/.${path##*/}.prev"
        case "$action" in
            restore) if [ -f "$prev" ]; then mv -f "$prev" "$path"; fi ;;
            remove) rm -f "$path" ;;
        esac
    done < "$UPDATE_DIR/trial"
    mv -f "$UPDATE_DIR/trial" "$UPDATE_DIR/rolled-back"
    rm -f "$UPDATE_DIR/boots" "$RUN_DIR/waved-trial-boot" "$RUN_DIR/waved-trial-starts"
    sync
}

case "$1" in
    start)
        echo "Starting waved..."

        # Apply firewall rules
        if [ -f /data/waved/iptables.rules ]; then
            iptables-restore < /data/waved/iptables.rules 2>/dev/null || true
        fi

        # Ensure directories exist
        mkdir -p /data/waved
        mkdir -p /mnt/udisk/recordings

        # Set permissions on config
        chmod 0600 /data/waved/config.toml 2>/dev/null || true

        # Start waved with watchdog respawn
        (
            while true; do
                # /data is small (the binary alone is ~62 MB of it): keep
                # one previous log past 2 MB instead of appending forever.
                if [ "$(wc -c < /data/waved/waved.log 2>/dev/null || echo 0)" -gt 2097152 ]; then
                    mv /data/waved/waved.log /data/waved/waved.log.1
                fi
                update_guard
                /data/waved/waved >>/data/waved/waved.log 2>&1
                echo "waved exited ($?), restarting in 3s..." >>/data/waved/waved.log
                sleep 3
            done
        ) &

        # The first waved instance after boot always has a broken display
        # (fb_ili79400 deferred-I/O not active). Kill it after 5s so the
        # watchdog restarts it — the second instance works reliably.
        (sleep 5 && killall -TERM waved) &
        ;;
    stop)
        echo "Stopping waved..."
        killall waved 2>/dev/null
        ;;
    guard)
        # One pass of the update fall-back, as the watchdog runs it (tests).
        update_guard
        ;;
    *)
        echo "Usage: $0 {start|stop|guard}"
        exit 1
        ;;
esac
