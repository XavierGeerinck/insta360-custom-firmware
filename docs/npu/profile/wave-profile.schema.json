{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/insta360-wave/wave-profile.schema.json",
  "title": "Insta360 Wave NPU architecture evidence profile",
  "description": "Strict, evidence-carrying profile recovered without invoking target architecture or compiler libraries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "inputs",
    "identity",
    "features",
    "resources",
    "versions",
    "unknowns",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "hex"
      ],
      "properties": {
        "value": {
          "const": 268435470
        },
        "hex": {
          "const": "0x1000000e"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "identity": {
      "$ref": "#/$defs/factSection"
    },
    "features": {
      "$ref": "#/$defs/factSection"
    },
    "resources": {
      "$ref": "#/$defs/factSection"
    },
    "versions": {
      "$ref": "#/$defs/factSection"
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(identity|features|resources|versions)\\.[a-z0-9][a-z0-9._-]*$"
      }
    },
    "non_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "bytes",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "location"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "representation",
        "evidence_class",
        "confidence",
        "sources",
        "validation_state",
        "notes"
      ],
      "properties": {
        "value": true,
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "observed-live",
            "static-verified",
            "differentially-verified",
            "inferred",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "validation_state": {
          "enum": [
            "corroborated",
            "single-source",
            "candidate",
            "unresolved"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "evidence_class": {
            "const": "unknown"
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "confidence": {
            "const": "none"
          },
          "sources": {
            "type": "array",
            "maxItems": 0
          },
          "validation_state": {
            "const": "unresolved"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1
          },
          "validation_state": {
            "enum": [
              "corroborated",
              "single-source",
              "candidate"
            ]
          }
        }
      }
    },
    "factSection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    }
  }
}
