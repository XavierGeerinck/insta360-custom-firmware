# Rust build artifacts
**/target/
**/target-centos/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.claude/

# Environment / secrets
.env
.env.*
config/local.toml

# Device data (generated on-device)
*.db
*.db-shm
*.db-wal
recordings/
pulled-recordings/
recordings-backup-*/

# Debug dumps
*.pcm
*.raw
audio_dump/

# Large binary assets (kept local only)
models/
# Tracked NPU model documentation and qualification metadata (no binaries).
!docs/npu/models/
!docs/npu/models/erf-mask/
!docs/npu/models/erf-mask/**
ghidra_projects/
*.swu
*.pkg
# Firmware blobs (per vendor, multi-GB) + their extracted/decompiled outputs.
# Keep the per-firmware CHANGELOG.md and the top-level firmwares/README.md
# tracked so the analysis stays in git; everything heavy is local-only.
firmwares/*/*.bin
firmwares/*/extracted/
firmwares/*/decompiled/

# Brainstorming / visual companion session files
.superpowers/

# Serena MCP tool project config (project-local, not for VCS)
.serena/

# Compiled binaries that land at repo root via tooling
rust_out
waved/rust_out

# Device backups — contain per-device secrets (unifykey, bindkey, TEA license).
# Keep the README tracked so the backup layout is documented, but exclude the
# actual captured bytes (partitions and pulled /etc text files that may
# include shadow/passwd).
backups/**
!backups/README.md

# Raw Wave NPU lab runs (envelopes are summarized in tracked notebooks).
/artifacts/npu/

**/target-linux/
