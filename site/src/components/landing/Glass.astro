---
// The Wave's round glass with real UI renders behind it. The panel is a
// 400x304 framebuffer seen through a circle of radius 198 centred at
// (200, 106) (waved/docs/DISPLAY_HARDWARE.md), so the top of the glass is
// black glass with no pixels behind it, as on the device. With five screens
// the glass crossfades through them; with one it simply shows it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Screen {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}
interface Props {
	screens: Screen[];
	size?: 'hero' | 'small';
}

const { screens, size = 'small' } = Astro.props;
const cycle = screens.length > 1;
if (cycle && screens.length !== 5) {
	throw new Error('Glass cycles exactly five screens (the keyframes are built for five)');
}
---

<figure class:list={['glass', size, { cycle }]}>
	<div class="bezel">
		<div class="panel">
			{
				screens.map((s, i) => (
					<Image
						src={s.src}
						alt={s.alt}
						width={400}
						class="screen"
						style={`--i:${i}`}
						loading={size === 'hero' ? 'eager' : 'lazy'}
					/>
				))
			}
		</div>
	</div>
	{
		cycle && (
			<figcaption aria-hidden="true">
				{screens.map((s, i) => (
					<span style={`--i:${i}`}>{s.caption}</span>
				))}
			</figcaption>
		)
	}
</figure>

<style>
	.glass {
		--d: 10.5rem;
		margin: 0;
		width: var(--d);
	}
	.glass.hero {
		--d: min(29rem, 84vw);
	}

	.bezel {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		padding: 4.5%;
		background: radial-gradient(circle at 50% 22%, #33403f, #182022 62%, #10171a);
		box-shadow:
			0 0 0 1px var(--wave-line),
			inset 0 1px 0 rgb(255 255 255 / 0.07);
	}
	.hero .bezel {
		box-shadow:
			0 0 0 1px var(--wave-line),
			inset 0 1px 0 rgb(255 255 255 / 0.08),
			0 0 5rem -0.5rem rgb(63 214 177 / 0.22),
			0 2.5rem 4rem -2rem rgb(0 0 0 / 0.7);
	}

	.panel {
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		background: var(--wave-glass);
	}

	/* Circle geometry in framebuffer units: the circle spans x 2..398 and
	   y -92..304, so the 400x304 image sits 92/396 down and 2/396 left. */
	.panel :global(.screen) {
		position: absolute;
		left: -0.505%;
		top: 23.23%;
		width: 101.01%;
		height: auto;
	}

	figcaption {
		position: relative;
		height: 1.5rem;
		margin-top: 1.25rem;
		text-align: center;
		color: var(--wave-text-2);
		font: 500 1rem/1.5 var(--wave-font-display);
		letter-spacing: 0.01em;
	}
	figcaption span {
		position: absolute;
		inset: 0;
	}

	/* Five screens, 3.6 s each: every screen owns a fifth of the loop. Like the
	   panel changing screens, the old one goes dark before the new one lights
	   up, so two UIs never show at once; its caption follows the same timing. */
	.cycle :global(.screen),
	.cycle figcaption span {
		opacity: 0;
		animation: wave-show 18s infinite;
		animation-delay: calc(var(--i) * 3.6s);
	}
	.cycle:hover :global(.screen),
	.cycle:hover figcaption span {
		animation-play-state: paused;
	}

	@keyframes wave-show {
		0%,
		2% {
			opacity: 0;
		}
		5%,
		18% {
			opacity: 1;
		}
		20%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cycle :global(.screen),
		.cycle figcaption span {
			animation: none;
		}
		.cycle :global(.screen:first-child),
		.cycle figcaption span:first-child {
			opacity: 1;
		}
	}
</style>
